# ── Nothing here is required to run locally. ──
# On Vercel set these in Project Settings → Environment Variables.
# Never commit a filled-in .env.

# ── Routing ──────────────────────────────────────────────────────────
# local:      demo.localhost
# production: demo.caito360.ai
DEMO_PARENT_DOMAIN=demo.localhost

# ── Tenant storage ───────────────────────────────────────────────────
# UNSET  → reads the bundled JSON in data/. Fine locally, but every new
#          prospect then needs a redeploy. Do not run a campaign on it.
# SET    → Postgres. Adding a demo is an INSERT: no build, no deploy.
# Use the POOLED connection string (Neon/Supabase), not the direct one —
# serverless opens many short-lived connections.
DATABASE_URL=

# ── Ingest auth ──────────────────────────────────────────────────────
# Shared secret for /api/admin/*. Generate with:  openssl rand -hex 32
# If unset, those endpoints are CLOSED, not open.
ADMIN_TOKEN=

# ── Logo storage ─────────────────────────────────────────────────────
# Vercel Blob. Logos cannot live in public/ — that is baked at build,
# so a new logo would mean a new deploy.
BLOB_READ_WRITE_TOKEN=

# ── GoHighLevel ──────────────────────────────────────────────────────
# Private Integration Token from a sub-account:
#   Settings → Private Integrations → Create new integration
# Scopes: contacts.readonly, contacts.write, opportunities.readonly,
#         opportunities.write, calendars.readonly, calendars/events.write
# With this set, contacts and appointments are created via the API and a
# free "Tag Added" workflow trigger fires. Without it the code falls back
# to the inbound webhook — a premium, per-execution trigger.
GHL_TOKEN=
GHL_API_VERSION=2021-07-28

# Fallback inbound-webhook URL for tenants with none of their own.
# WRITE-ONLY workflow trigger. No key, no scopes, no developer account.
GHL_DEFAULT_ENQUIRY_HOOK=

# ── Live demo studio ─────────────────────────────────────────────────
# Turns on /studio: paste a URL or type details, get a live demo.
# Needs DATABASE_URL. OFF by default — a public "build me a demo"
# endpoint is not something to leave running once real prospects have
# links. Turn it on for a meeting, turn it off afterwards.
STUDIO_ENABLED=false

# Used by /api/extract for live reads on a call. Without it the studio
# still works but the copy is generic.
ANTHROPIC_API_KEY=

# ── Shared GHL sub-account for every demo ────────────────────────────
# With these set, a demo generated live on a call gets live calendar
# slots immediately — no per-demo binding step.
#
# All demos then share one sub-account, so contacts from different
# prospects land together. Fine while demos are internal. Before real
# prospects can submit forms this must become one sub-account per
# vertical, or prospect A will see prospect B in the contact list.
GHL_DEFAULT_LOCATION_ID=
GHL_DEFAULT_CALENDAR_ID=

# ── Owner acceptance ─────────────────────────────────────────────────
# Inbound-webhook URL of the workflow that CONFIRMS a requested visit
# and emails the customer. Fired by the Accept button in the owner panel.
# Falls back to the enquiry hook if unset, so the button always does
# something — but a dedicated workflow is what makes the demo land.
GHL_ACCEPT_HOOK=

# ── Booking ──────────────────────────────────────────────────────────
# Inbound-webhook URL of the workflow that handles a REQUESTED visit —
# it can word its emails around "we'll confirm within the hour", which
# the enquiry workflow cannot. Falls back to the enquiry hook if unset.
GHL_BOOKING_HOOK=
